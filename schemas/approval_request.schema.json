{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalRequestSchema",
  "type": "object",
  "required": [
    "request_id",
    "post_id",
    "requested_at",
    "action_scope",
    "target_platform",
    "proposed_schedule_time",
    "canonical_payload_sha256",
    "content_summary",
    "content_full_text",
    "media_asset_hashes",
    "scorecard_summary"
  ],
  "properties": {
    "request_id": { "type": "string", "pattern": "^appr_req_[a-z0-9_]+$" },
    "post_id": { "type": "string" },
    "requested_at": { "type": "string", "format": "date-time" },
    "action_scope": { "type": "string", "enum": ["METRICOOL_SCHEDULE", "METRICOOL_PUBLISH_NOW", "METRICOOL_COMMENT_REPLY"] },
    "target_platform": { "type": "string", "enum": ["linkedin"] },
    "proposed_schedule_time": { "type": "string", "format": "date-time" },
    "canonical_payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "content_summary": { "type": "string" },
    "content_full_text": { "type": "string" },
    "media_asset_hashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "scorecard_summary": {
      "type": "object",
      "required": ["composite_score", "slop_detected", "grounding_percentage"],
      "properties": {
        "composite_score": { "type": "number" },
        "slop_detected": { "type": "boolean" },
        "grounding_percentage": { "type": "number" }
      }
    }
  },
  "additionalProperties": false
}
